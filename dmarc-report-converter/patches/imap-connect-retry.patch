index 0000000..536f442
--- /dev/null
+++ b/cmd/dmarc-report-converter/imap_connect_test.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"net"
+	"testing"
+	"time"
+)
+
+func closedAddr(t *testing.T) string {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := l.Addr().String()
+	l.Close()
+	return addr
+}
+
+func recordSleeps(t *testing.T) *[]time.Duration {
+	t.Helper()
+	var sleeps []time.Duration
+	oldSleep := imapSleep
+	imapSleep = func(d time.Duration) { sleeps = append(sleeps, d) }
+	t.Cleanup(func() { imapSleep = oldSleep })
+	return &sleeps
+}
+
+func TestConnectIMAPRetriesRefusedConnection(t *testing.T) {
+	sleeps := recordSleeps(t)
+	addr := closedAddr(t)
+	for _, security := range []string{"plaintext", "starttls", "tls"} {
+		t.Run(security, func(t *testing.T) {
+			*sleeps = nil
+			c, err := connectIMAP(IMAP{Server: addr, Security: security})
+			if err == nil || c != nil {
+				t.Fatalf("connectIMAP() = %v, %v; want nil client and error", c, err)
+			}
+			want := []time.Duration{time.Second, 2 * time.Second, 4 * time.Second, 8 * time.Second}
+			if len(*sleeps) != len(want) {
+				t.Fatalf("slept %v, want %v", *sleeps, want)
+			}
+			for i := range want {
+				if (*sleeps)[i] != want[i] {
+					t.Fatalf("slept %v, want %v", *sleeps, want)
+				}
+			}
+		})
+	}
+}
+
+func TestConnectIMAPClosesClientWhenStartTLSUnavailable(t *testing.T) {
+	sleeps := recordSleeps(t)
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	accepted := make(chan struct{}, 8)
+	go func() {
+		for {
+			conn, err := l.Accept()
+			if err != nil {
+				return
+			}
+			conn.Write([]byte("* OK [CAPABILITY IMAP4rev1] ready\r\n"))
+			go func() {
+				buf := make([]byte, 512)
+				for {
+					if _, err := conn.Read(buf); err != nil {
+						conn.Close()
+						accepted <- struct{}{}
+						return
+					}
+				}
+			}()
+		}
+	}()
+
+	c, err := connectIMAP(IMAP{Server: l.Addr().String(), Security: "starttls"})
+	if err == nil || c != nil {
+		t.Fatalf("connectIMAP() = %v, %v; want nil client and error", c, err)
+	}
+	if err.Error() != "server doesn't support starttls" {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(*sleeps) != 4 {
+		t.Fatalf("slept %v, want 4 backoff delays", *sleeps)
+	}
+	for i := 0; i < 5; i++ {
+		select {
+		case <-accepted:
+		case <-time.After(5 * time.Second):
+			t.Fatalf("connection %d was not closed by the client", i+1)
+		}
+	}
+}
