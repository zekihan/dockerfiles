+package imapsmtpserver
+
+import (
+ "crypto/tls"
+ "net"
+ "testing"
+)
+
+func TestConfiguredListenerAddress(t *testing.T) {
+ for _, host := range []string{"", "127.0.0.1", "0.0.0.0"} {
+  for _, encrypted := range []bool{false, true} {
+   t.Run(host+map[bool]string{false:"/plain",true:"/tls"}[encrypted], func(t *testing.T) {
+    t.Setenv("BRIDGE_LISTEN_ADDRESS", host)
+    listener, err := newListener(0, encrypted, &tls.Config{Certificates: []tls.Certificate{{}}})
+    if err != nil { t.Fatal(err) }
+    defer listener.Close()
+    ip := listener.Addr().(*net.TCPAddr).IP
+    if host == "0.0.0.0" { if !ip.IsUnspecified() { t.Fatalf("expected wildcard, got %s", ip) } } else if !ip.IsLoopback() { t.Fatalf("expected loopback, got %s", ip) }
+   })
+  }
+ }
+}
+
+func TestInvalidListenerAddress(t *testing.T) {
+ for _, host := range []string{"bridge.example", "127.0.0.1:1143", " 0.0.0.0"} {
+  t.Setenv("BRIDGE_LISTEN_ADDRESS", host)
+  if listener, err := newListener(0, false, nil); err == nil { listener.Close(); t.Fatalf("accepted invalid address %q", host) }
+ }
+}
